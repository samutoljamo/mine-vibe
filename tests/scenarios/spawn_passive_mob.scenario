# spawn_passive_mob: spawn a pig and confirm it appears with the right type and
# health. type 3 = MOB_PIG (passive), which spawns with 10 hp (vs 20 for the
# hostile zombie). The first spawned mob gets id 1.
> {"cmd":"step","ticks":10}
> {"cmd":"spawn_mob","type":3,"x":1.5,"y":105,"z":0.5}
> {"cmd":"step","ticks":3}
expect mobs[0].id == 1
expect mobs[0].type == 3
expect mobs[0].health == 10
